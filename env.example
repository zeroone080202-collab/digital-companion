# Local demo works without secrets. Never commit your real .env.
DEPLOYMENT_MODE=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATA_ENCRYPTION_KEY=
ALLOW_OPEN_SIGNUP=true
DATASET_RIGHTS_CONFIRMED=false
OPERATOR_CONTACT=
ALLOWED_HOSTS=127.0.0.1,localhost
# Optional: KNOWLEDGE_DB=/absolute/path/to/knowledge.sqlite
# REVIEW_SUPABASE_SERVICE_KEY is for the OFFLINE review tool ONLY.
# Do not put a privileged review/service key on the public web server.

GUEST_DAILY_LIMIT=5
